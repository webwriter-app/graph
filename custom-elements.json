              "type": {
                "text": "object"
              },
              "static": true,
              "default": "{ configurePermissions: { label: (widget: { msg: MsgFn }) => widget.msg('Configure graph permissions') }, }"
            },
            {
              "kind": "field",
              "name": "convertFrom",
              "static": true,
              "default": "convertFrom"
            },
            {
              "kind": "field",
